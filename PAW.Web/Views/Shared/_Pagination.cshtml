@model PAW.Web.Models.IPagedResult
@{
    // Format:  <<  <  ... 5  [6]  7 ...  >  >>
    //          First, previous, ... before, current, next ... after, last
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var current = Model.Page;
    var total = Math.Max(Model.TotalPages, 1);
    var prev = Math.Max(current - 1, 1);
    var next = Math.Min(current + 1, total);
}

<nav aria-label="Pagination" class="mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2">

    <small class="text-muted">
        Page @current of @total &middot; @Model.TotalItems item(s)
    </small>

    <ul class="pagination pagination-sm mb-0">

        @* << First *@
        @if (current > 1)
        {
            <li class="page-item"><a class="page-link" asp-controller="@controller" asp-action="Index" asp-route-page="1" title="First">&laquo;</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">&laquo;</span></li>
        }

        @* < Previous *@
        @if (current > 1)
        {
            <li class="page-item"><a class="page-link" asp-controller="@controller" asp-action="Index" asp-route-page="@prev" title="Previous">&lsaquo;</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">&lsaquo;</span></li>
        }

        @* ... pages before *@
        @if (current - 1 > 1)
        {
            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
        }

        @* before *@
        @if (current > 1)
        {
            <li class="page-item"><a class="page-link" asp-controller="@controller" asp-action="Index" asp-route-page="@prev">@prev</a></li>
        }

        @* current *@
        <li class="page-item active" aria-current="page"><span class="page-link fw-bold">@current</span></li>

        @* next *@
        @if (current < total)
        {
            <li class="page-item"><a class="page-link" asp-controller="@controller" asp-action="Index" asp-route-page="@next">@next</a></li>
        }

        @* after ... *@
        @if (current + 1 < total)
        {
            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
        }

        @* > Next *@
        @if (current < total)
        {
            <li class="page-item"><a class="page-link" asp-controller="@controller" asp-action="Index" asp-route-page="@next" title="Next">&rsaquo;</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">&rsaquo;</span></li>
        }

        @* >> Last *@
        @if (current < total)
        {
            <li class="page-item"><a class="page-link" asp-controller="@controller" asp-action="Index" asp-route-page="@total" title="Last">&raquo;</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">&raquo;</span></li>
        }

    </ul>
</nav>
