@model PAW.Models.DTO.UserDTO

    <div class="mb-3">
        <label asp-for="Username" class="form-label">Username</label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
        <div class="form-text">@(ViewData["IsEdit"] is true ? "Leave blank to keep the current password." : "Stored as a SHA-256 hash.")</div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" checked="@(Model.IsActive == true)" />
        <input type="hidden" name="IsActive" value="false" />
        <label class="form-check-label" for="IsActive">Is Active</label>
    </div>
    <div class="mb-3">
        <label asp-for="RoleId" class="form-label">Role</label>
        <select asp-for="RoleId" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Roles">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="RoleId" class="text-danger"></span>
    </div>
