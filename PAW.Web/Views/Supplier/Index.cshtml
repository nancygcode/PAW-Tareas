@model PAW.Web.Models.PagedResult<PAW.Models.DTO.SupplierDTO>
@{
    ViewData["Title"] = "Suppliers Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Suppliers</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Supplier
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Supplier ID</th>
                            <th>Supplier Name</th>
                            <th>Contact Name</th>
                            <th>Contact Title</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>City</th>
                            <th>Country</th>
                            <th>Last Modified</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @item.SupplierId
                                    </td>

                                    <td>
                                        @item.SupplierName
                                    </td>

                                    <td>
                                        @item.ContactName
                                    </td>

                                    <td>
                                        @item.ContactTitle
                                    </td>

                                    <td>
                                        @item.Phone
                                    </td>

                                    <td>
                                        @item.Address
                                    </td>

                                    <td>
                                        @item.City
                                    </td>

                                    <td>
                                        @item.Country
                                    </td>

                                    <td>
                                        @(item.LastModified?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td>
                                        @item.ModifiedBy
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.SupplierId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <!-- Details (loads a partial view inside the modal) -->
                                            <a href="#"
                                               data-url="@Url.Action("Details", new { id = item.SupplierId })"
                                               class="btn btn-sm btn-info js-details">
                                                Details
                                            </a>

                                            <!-- Delete -->
                                            <a href="#"
                                               data-url="@Url.Action("Delete", new { id = item.SupplierId })"
                                               data-confirm="Do you want to delete this record?"
                                               class="btn btn-sm btn-danger js-delete">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center">
                                    No suppliers found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_Pagination" model="Model" />

        </div>
    </div>

</div>

<partial name="_DetailsModal" />
<partial name="_DeleteForm" />
