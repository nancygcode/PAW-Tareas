@model PAW.Models.DTO.NotificationDTO

    <div class="mb-3">
        <label asp-for="UserId" class="form-label">User ID</label>
        <input asp-for="UserId" type="number" class="form-control" />
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Message" class="form-label">Message</label>
        <input asp-for="Message" class="form-control" />
        <span asp-validation-for="Message" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="IsRead" name="IsRead" value="true" checked="@(Model.IsRead == true)" />
        <input type="hidden" name="IsRead" value="false" />
        <label class="form-check-label" for="IsRead">Is Read</label>
    </div>
