@model PAW.Web.Models.PagedResult<PAW.Models.DTO.NotificationDTO>
@{
    ViewData["Title"] = "Notifications Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notifications</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Notification
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>User ID</th>
                            <th>Message</th>
                            <th>Is Read</th>
                            <th>Created At</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @item.Id
                                    </td>

                                    <td>
                                        @item.UserId
                                    </td>

                                    <td>
                                        @item.Message
                                    </td>

                                    <td>
                                        @if (item.IsRead == true)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>

                                    <td>
                                        @(item.CreatedAt?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <!-- Details (loads a partial view inside the modal) -->
                                            <a href="#"
                                               data-url="@Url.Action("Details", new { id = item.Id })"
                                               class="btn btn-sm btn-info js-details">
                                                Details
                                            </a>

                                            <!-- Delete -->
                                            <a href="#"
                                               data-url="@Url.Action("Delete", new { id = item.Id })"
                                               data-confirm="Do you want to delete this record?"
                                               class="btn btn-sm btn-danger js-delete">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    No notifications found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_Pagination" model="Model" />

        </div>
    </div>

</div>

<partial name="_DetailsModal" />
<partial name="_DeleteForm" />
