@model PAW.Models.DTO.UserRoleDTO

    <div class="mb-3">
        <label asp-for="Id" class="form-label">Id</label>
        @if (ViewData["IsEdit"] is true)
        {
            <input asp-for="Id" type="number" class="form-control" readonly />
        }
        else
        {
            <input asp-for="Id" type="number" class="form-control" />
        }
        <span asp-validation-for="Id" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RoldId" class="form-label">Role ID</label>
        <input asp-for="RoldId" type="number" class="form-control" />
        <span asp-validation-for="RoldId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UserId" class="form-label">User ID</label>
        <input asp-for="UserId" type="number" class="form-control" />
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>
