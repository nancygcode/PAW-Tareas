@model PAW.Models.DTO.ComponentDTO

<dl class="row mb-0">
    <dt class="col-sm-4">Id</dt>
    <dd class="col-sm-8">@Model.Id</dd>
    <dt class="col-sm-4">Name</dt>
    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Name) ? "—" : Model.Name)</dd>
    <dt class="col-sm-4">Content</dt>
    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Content) ? "—" : Model.Content)</dd>
</dl>
